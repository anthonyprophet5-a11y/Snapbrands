# ==========================================
# SnapBrand Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment Secrets and Local Configurations
.env
.env.*
!.env.example
local.properties

# SQLite Databases, WAL, SHM (Local & Ephemeral State)
*.db
*.db-wal
*.db-shm
web/data/*.db
web/data/*.db-wal
web/data/*.db-shm

# Build Artifacts & Output Directories
build/
/build
app/build/
.build-outputs/
captures/
/captures
.externalNativeBuild
.cxx

# Gradle & Kotlin Caches
.gradle/
.kotlin/

# Python Caches & Bytecode
__pycache__/
*.pyc
*.pyo

# IDE & Editor Files
*.iml
.idea/
.vscode/
.DS_Store

# Android Keystores & Signing Keys
debug.keystore
debug.keystore.base64
*.keystore
*.jks

# Logs
logs/
*.log
